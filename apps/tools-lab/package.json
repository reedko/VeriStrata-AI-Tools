{
  "name": "@veristrata-ai-tools/tools-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @veristrata-ai-tools/contracts && npm run build -w @veristrata-ai-tools/sdk && npm run build -w @veristrata-ai-tools/integrity-core && npm run build -w @veristrata-ai-tools/mcp-server",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test server/**/*.test.ts",
    "db:migrate": "tsx server/migrate.ts",
    "keys": "tsx server/keys.ts"
  },
  "dependencies": {
    "@veristrata-ai-tools/contracts": "0.1.0",
    "@veristrata-ai-tools/integrity-core": "0.1.0",
    "@veristrata-ai-tools/mcp-server": "0.1.0",
    "@veristrata-ai-tools/sdk": "0.1.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
